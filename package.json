{
  "name": "libsql-search",
  "version": "0.11.2",
  "description": "Semantic search for static sites using libSQL/Turso with multi-provider embeddings",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./turso": {
      "types": "./dist/turso.d.ts",
      "import": "./dist/turso.esm.js",
      "require": "./dist/turso.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc --noEmit && rollup -c && rollup -c rollup.dts.config.js",
    "build:runtime": "tsc --noEmit && rollup -c",
    "build:types": "rollup -c rollup.dts.config.js",
    "dev": "rollup -c --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:release-plan": "node --test ./scripts/plan-release.node-test.mjs",
    "check:deno": "deno task check",
    "check:dist-types": "node ./scripts/check-dist-types.mjs",
    "smoke:package": "node ./scripts/smoke-package.mjs",
    "validate:release-version": "node ./scripts/validate-release-version.mjs",
    "validate:package": "tsc --noEmit && rollup -c && rollup -c rollup.dts.config.js && node ./scripts/check-dist-types.mjs && node ./scripts/smoke-package.mjs",
    "validate:release": "pnpm audit --audit-level moderate && pnpm test:release-plan && pnpm test:coverage && pnpm validate:package && pnpm check:deno",
    "prepublishOnly": "pnpm validate:release"
  },
  "keywords": [
    "libsql",
    "turso",
    "vector-search",
    "semantic-search",
    "embeddings",
    "static-sites",
    "markdown",
    "astro",
    "nextjs"
  ],
  "author": "llbbl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llbbl/libsql-search.git"
  },
  "bugs": {
    "url": "https://github.com/llbbl/libsql-search/issues"
  },
  "homepage": "https://github.com/llbbl/libsql-search#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@libsql/client": "^0.15.0 || ^0.17.0",
    "@tursodatabase/database": "^0.7.0 || ^0.8.0"
  },
  "peerDependenciesMeta": {
    "@tursodatabase/database": {
      "optional": true
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tursodatabase/database": "^0.7.2",
    "@types/node": "^26.4.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "^5.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@google/genai": "2.21.0"
  }
}
